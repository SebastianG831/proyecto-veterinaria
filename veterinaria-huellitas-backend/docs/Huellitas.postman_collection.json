{
  "info": {
    "name": "Veterinaria Huellitas - API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar las carpetas en orden. Antes de empezar, pon en la variable passwordAdmin la contraseña del administrador."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Calcula fechas válidas para las pruebas (hora de Lima, a partir de dentro de una semana)",
          "const pad = n => String(n).padStart(2, '0');",
          "const fmt = (d, h) => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(h)}:00:00`;",
          "const base = new Date(); base.setDate(base.getDate() + 7);",
          "while (base.getDay() === 0) base.setDate(base.getDate() + 1);      // evita domingo",
          "const dom = new Date(base); dom.setDate(dom.getDate() + ((7 - dom.getDay()) % 7 || 7)); // próximo domingo",
          "pm.collectionVariables.set('fechaValida', fmt(base, 10));",
          "pm.collectionVariables.set('fechaOtra', fmt(base, 15));",
          "pm.collectionVariables.set('fechaFueraHorario', fmt(base, 8));",
          "pm.collectionVariables.set('fechaDomingo', fmt(dom, 10));",
          "if (!pm.collectionVariables.get('emailCliente')) {",
          "  pm.collectionVariables.set('emailCliente', 'cliente' + Date.now() + '@mail.com');",
          "}"
        ]
      }
    }
  ],
